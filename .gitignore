# Build output
build/
*.o
*.a
*.so

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Logs and runtime output
log_files/
log/
*.log
events/
*.mp4
*.mjpg

# Generated by tools/embed_web_ui.py
src/web/web_ui_generated.h

# Rockchip headers are supplied by the SDK and must not be redistributed here.
third_party/rknn/*.h

# Models: the default detector, low-power alternative and labels are tracked.
# Optional/generated models are intentionally excluded.
models/*
!models/README.md
!models/yolov8s-640-640.rknn
!models/yolov8n-640-640.rknn
!models/coco_80_labels_list.txt
*.rknn
!models/yolov8s-640-640.rknn
!models/yolov8n-640-640.rknn
*.onnx
*.pt

# Editors and local metadata
.vscode/
.idea/
*.swp
.DS_Store
